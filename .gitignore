node_modules/
dist/
build/
coverage/

# Storybook's static build. A third build output directory, and the only one
# not named `dist` or `build` — it needs its own entry here, in .prettierignore
# and in eslint.config.mjs.
storybook-static/

# Composite projects write this next to the tsconfig, not into dist/, so the
# rule above does not catch it.
*.tsbuildinfo

.env
.env.*
!.env.example

*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

.DS_Store
.tmp/
tmp/
temp/
