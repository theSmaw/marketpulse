node_modules/
dist/
build/
coverage/

# Storybook's static build. A third build output directory, and the only one
# not named `dist` or `build` — it needs its own entry here, in .prettierignore
# and in eslint.config.mjs.
storybook-static/

# Composite projects write this next to the tsconfig, not into dist/, so the
# rule above does not catch it.
*.tsbuildinfo

# The browser suite's failure artefacts (Task 1.13.2). `test-results/` is
# Playwright's `outputDir` and holds a trace and a screenshot per failed test
# and nothing at all on a green run; `playwright-report/` is the HTML reporter's
# output, which this configuration does not currently enable. Both are named
# here for the reason `coverage/` and `storybook-static/` are: a run must leave
# nothing untracked behind it, and `git status` after a red run is how that was
# checked rather than reasoned about. Mirrored in .prettierignore and
# eslint.config.mjs.
test-results/
playwright-report/

.env
.env.*
!.env.example

*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

.DS_Store
.tmp/
tmp/
temp/

# Claude Code's project directory is tracked for what is shared — `skills/`,
# and anything else the team is meant to have. The two entries below are not
# shared: `settings.local.json` is per-machine permission state, and
# `worktrees/` holds entire second checkouts of this repository nested inside
# it (also ignored by Prettier and ESLint, for the same reason).
.claude/settings.local.json
.claude/worktrees/
