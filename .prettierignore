# Prettier's own ignore file. Everything not listed here is formatted —
# including `eslint.config.mjs` and `prettier.config.mjs`, which are source like
# any other.
#
# `tsconfig.base.json` is deliberately absent. It is JSONC, and Prettier infers
# the plain `json` parser for it because the `.base.` infix misses Prettier's
# JSONC filename list — but that parser preserves comments regardless, so the
# per-option reasoning in it survives formatting. Verified; no `overrides` entry
# is needed and none should be added.

# Build output.
dist/
build/
coverage/

# Storybook's static build (Task 1.4.5). Named neither `dist` nor `build`, so
# the entries above do not reach it. Mirrored in eslint.config.mjs.
storybook-static/

# Incremental build state. A single-line JSON blob that TypeScript rewrites on
# every build and Prettier would otherwise expand into a formatted document,
# producing a diff per build.
*.tsbuildinfo

# Generated by pnpm; owned by pnpm.
pnpm-lock.yaml

node_modules/

# Git worktrees — entire second checkouts of this repository, nested inside it.
# Root-level `prettier .` (Task 1.1.7) walks into them otherwise and rewrites
# files belonging to another branch. Mirrored in eslint.config.mjs.
.claude/worktrees/
