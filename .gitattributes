# Line endings are normalised by git, not by the editor. `.editorconfig` tells
# an editor what to write; it has no say in what git checks out, so without
# this a checkout on Windows produces CRLF working files that Prettier and diff
# both consider changed.
#
# `text=auto` stores every text file with LF in the repository; `eol=lf` checks
# it back out as LF on every platform, rather than deferring to the local
# `core.autocrlf`.
* text=auto eol=lf

# Binary files git might otherwise sniff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary

# Generated by pnpm and reviewed by machines. `linguist-generated` collapses it
# by default in diffs and excludes it from language statistics; `-diff` keeps a
# lockfile churn out of `git diff` unless explicitly asked for.
pnpm-lock.yaml linguist-generated=true -diff
