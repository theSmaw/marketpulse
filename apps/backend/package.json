{
  "name": "@marketpulse/backend",
  "version": "0.0.0",
  "private": true,
  "description": "MarketPulse API server \u2014 Fastify, TypeScript, ESM",
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "dev": "sh scripts/dev.sh",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:process": "vitest run --config vitest.process.config.ts",
    "test:database": "vitest run --config vitest.database.config.ts",
    "coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "typecheck": "tsc -b",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@marketpulse/shared": "workspace:*",
    "fastify": "5.12.1",
    "kysely": "0.29.5",
    "pg": "8.23.0",
    "pino-pretty": "13.1.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1"
  }
}
