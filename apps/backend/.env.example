# Configuration for @marketpulse/backend.
#
#   cp apps/backend/.env.example apps/backend/.env
#
# The destination matters. This file is loaded by `process.loadEnvFile()` from
# `apps/backend/src/config.ts`, resolved from the module rather than from the
# current working directory — so it is `apps/backend/.env` and no other path. A
# `.env` at the repository root is read by nothing, silently.
#
# You do not need one. Every variable below has a default and a fresh clone
# starts on all of them; a missing file is swallowed deliberately, because two
# of the three environments have no file by design (the test runner and the
# container both supply real environment variables instead).
#
# Precedence, measured both ways round in Task 1.6.3: a real environment
# variable BEATS an entry in this file. That is what a container depends on.
#
# A blank value is treated as absent, not as an empty string — `PORT=` gives
# 3000 rather than "any free port". Uncommenting a line and not filling it in
# is therefore safe.
#
# This file is checked against `CONFIG_VARIABLES` in
# `apps/backend/src/config.ts` by `pnpm env:check`, a step in `pnpm verify`.
# Adding a variable to one and not the other fails the build. Do not add a
# variable here that nothing reads.

# --- Secrets ---
#
# There are none yet. When there are — Epic 2 brings Alpaca market-data
# credentials, Epic 10 an LLM provider key — they belong HERE and nowhere else.
#
# Market-data and model-provider credentials are server-side without exception.
# The browser talks to the MarketPulse backend; it never talks to Alpaca or to
# a model provider directly, so no credential ever needs to reach
# `apps/frontend`. See `apps/frontend/.env.example` for what happens if one is
# put there anyway.
#
# `.env` is gitignored and `.env.example` is not — the negation on line 17 of
# `.gitignore`. Real values go in `.env`; this file carries placeholders only.

# TCP port the API server listens on. An integer between 1 and 65535.
# Optional. Default: 3000
PORT=3000

# Interface the API server binds to. 0.0.0.0 to accept connections from outside
# the machine.
# Optional. Default: 127.0.0.1
HOST=127.0.0.1

# Lowest severity the server emits. One of fatal, error, warn, info, debug,
# trace, silent. `silent` emits nothing at all, errors included.
# Optional. Default: info
LOG_LEVEL=info

# How a log record is rendered: json or pretty. `pretty` is for a human reading
# a terminal and is what `pnpm dev` sets; anything shipping logs to a machine
# wants json.
# Optional. Default: json
LOG_FORMAT=json

# The one browser origin allowed to call this API, matched exactly (scheme,
# host and port). The default is the Vite dev server, so a fresh clone works
# with no .env at all; a deployment should set this to the site's own origin.
# Optional. Default: http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# --- The database (Task 2.1.3) ---
#
# Discrete variables and not a single DATABASE_URL. Task 2.1.1 chose Microsoft
# Entra authentication for the deployed server — password authentication
# `Disabled`, no admin user created at all — so the deployed password field is
# filled at connect time by code that mints a token per connection. There is no
# string to put inside a URL.
#
# THE DEFAULTS BELOW ARE THE LOCAL DEVELOPMENT DATABASE, AND THEY ARE ITS
# DEFINITION. `scripts/local-database.mjs` reads them out of the built
# `dist/config.js` and hands them to `compose.yaml`, so `pnpm db` creates the
# container these values connect to. Changing one here moves the container as
# well as the client — which is the point, and it is why there is no second
# copy of `5432` anywhere.

# Host the database is reached at. The default is the local development
# container `pnpm db` starts, which publishes on loopback only.
# Optional. Default: 127.0.0.1
DATABASE_HOST=127.0.0.1

# TCP port the database listens on. An integer between 1 and 65535.
# Optional. Default: 5432
DATABASE_PORT=5432

# Name of the database to connect to.
# Optional. Default: marketpulse
DATABASE_NAME=marketpulse

# Role to connect as. Under DATABASE_AUTH=entra this is the managed identity's
# own name rather than a database-local role.
# Optional. Default: marketpulse
DATABASE_USER=marketpulse

# How the connection authenticates: password or entra. `password` reads
# DATABASE_PASSWORD; `entra` mints a Microsoft Entra access token per
# connection from the container app's managed identity and never reads
# DATABASE_PASSWORD at all. Named rather than inferred, so a forgotten variable
# is a startup error instead of a confusing authentication failure.
# Optional. Default: password
DATABASE_AUTH=password

# Password for DATABASE_USER. Read only under DATABASE_AUTH=password, and
# setting it alongside DATABASE_AUTH=entra is a startup error rather than a
# value that is quietly ignored.
#
# The default is the local container's fixture and it is in this repository on
# purpose: it authenticates a container published on loopback only, holding a
# database whose contents are re-derivable from Alpaca. A real credential goes
# in `.env` and nowhere else — this file is tracked.
# Optional. Default: marketpulse
DATABASE_PASSWORD=marketpulse

# TLS for the database connection: disable, require, verify-full. The default
# suits the local container, which offers no TLS — `pnpm ready` reports that
# rather than treating it as a fault. `require` encrypts without verifying the
# certificate and is deliberately never a default; the managed server wants
# verify-full.
# Optional. Default: disable
DATABASE_SSL=disable

# --- Two variables this file deliberately does NOT document (Task 2.1.6) ---
#
# `IDENTITY_ENDPOINT` and `IDENTITY_HEADER` are injected by Azure Container Apps
# and are read by `src/entra-token.ts` under DATABASE_AUTH=entra, to mint the
# access token that is used as the database password. They are not here, and
# they are not in CONFIG_VARIABLES, for two reasons.
#
# They are not ours to set: nothing you can put in a local `.env` makes them
# work, so documenting them here would hand a clean clone two blank variables
# and a `pnpm env:check` that demands they exist.
#
# And `IDENTITY_HEADER` is itself a bearer credential — it authorises a caller
# to mint a database token — so keeping it out of the configuration module is
# what preserves that module's structural guarantee that it never holds the
# deployed credential. Local development uses DATABASE_AUTH=password, above, and
# never touches either of them.
