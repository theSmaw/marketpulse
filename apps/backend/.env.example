# Configuration for @marketpulse/backend.
#
#   cp apps/backend/.env.example apps/backend/.env
#
# The destination matters. This file is loaded by `process.loadEnvFile()` from
# `apps/backend/src/config.ts`, resolved from the module rather than from the
# current working directory — so it is `apps/backend/.env` and no other path. A
# `.env` at the repository root is read by nothing, silently.
#
# You do not need one. Every variable below has a default and a fresh clone
# starts on all of them; a missing file is swallowed deliberately, because two
# of the three environments have no file by design (the test runner and the
# container both supply real environment variables instead).
#
# Precedence, measured both ways round in Task 1.6.3: a real environment
# variable BEATS an entry in this file. That is what a container depends on.
#
# A blank value is treated as absent, not as an empty string — `PORT=` gives
# 3000 rather than "any free port". Uncommenting a line and not filling it in
# is therefore safe.
#
# This file is checked against `CONFIG_VARIABLES` in
# `apps/backend/src/config.ts` by `pnpm env:check`, a step in `pnpm verify`.
# Adding a variable to one and not the other fails the build. Do not add a
# variable here that nothing reads.

# --- Secrets ---
#
# There are none yet. When there are — Epic 2 brings Alpaca market-data
# credentials, Epic 10 an LLM provider key — they belong HERE and nowhere else.
#
# Market-data and model-provider credentials are server-side without exception.
# The browser talks to the MarketPulse backend; it never talks to Alpaca or to
# a model provider directly, so no credential ever needs to reach
# `apps/frontend`. See `apps/frontend/.env.example` for what happens if one is
# put there anyway.
#
# `.env` is gitignored and `.env.example` is not — the negation on line 17 of
# `.gitignore`. Real values go in `.env`; this file carries placeholders only.

# TCP port the API server listens on. An integer between 1 and 65535.
# Optional. Default: 3000
PORT=3000

# Interface the API server binds to. 0.0.0.0 to accept connections from outside
# the machine.
# Optional. Default: 127.0.0.1
HOST=127.0.0.1

# Lowest severity the server emits. One of fatal, error, warn, info, debug,
# trace, silent. `silent` emits nothing at all, errors included.
# Optional. Default: info
LOG_LEVEL=info

# How a log record is rendered: json or pretty. `pretty` is for a human reading
# a terminal and is what `pnpm dev` sets; anything shipping logs to a machine
# wants json.
# Optional. Default: json
LOG_FORMAT=json

# The one browser origin allowed to call this API, matched exactly (scheme,
# host and port). The default is the Vite dev server, so a fresh clone works
# with no .env at all; a deployment should set this to the site's own origin.
# Optional. Default: http://localhost:5173
CORS_ORIGIN=http://localhost:5173
