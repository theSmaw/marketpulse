# Editor conventions, for the things an editor decides before Prettier ever
# runs: what a new line ends with, what the Tab key inserts, whether the file
# ends in a newline. WebStorm and VS Code both read this natively with no
# per-machine setup.
#
# Where this overlaps Prettier — indentation, line endings — the two agree by
# construction. Prettier owns the formatting of the files it supports; this file
# covers everything else, and covers those files before Prettier is invoked.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown: two trailing spaces are a hard line break, so stripping them
# silently changes the rendered document.
[*.md]
trim_trailing_whitespace = false

# Generated by pnpm — leave it exactly as pnpm writes it.
[pnpm-lock.yaml]
insert_final_newline = unset
trim_trailing_whitespace = unset
