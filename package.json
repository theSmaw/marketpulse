{
  "name": "marketpulse",
  "version": "0.0.0",
  "private": true,
  "description": "AI-assisted situational awareness for US equities",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.20.0 <25",
    "pnpm": ">=11.24.0 <12"
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "tsc -b && pnpm --filter @marketpulse/frontend exec vite build",
    "test": "pnpm -r run test",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "typecheck": "tsc -b",
    "clean": "tsc -b --clean && rm -rf apps/frontend/dist",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm run build && pnpm run lint && pnpm run format:check && pnpm run test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2"
  }
}
